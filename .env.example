# APEX OSINT Environment Configuration

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Database Storage
# Local SQLite default (zero configuration):
DATABASE_URL=sqlite+aiosqlite:///apex_osint.db
# PostgreSQL scalable mode:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/apex_osint

# AI Engine - Google Gemini
# Optional: If not provided, APEX runs in local grounded reasoning mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=4096

# Optional 3rd Party Integrations
GITHUB_TOKEN=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
SECURITYTRAILS_API_KEY=
HIBP_API_KEY=

# Defensive & SSRF Guard Settings
BLOCK_PRIVATE_NETWORKS=true
HTTP_TIMEOUT_SECONDS=12.0
HTTP_MAX_REDIRECTS=3
MAX_RESPONSE_BYTES=5242880
